# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

server {

    listen                  127.0.0.1:8080;
    server_name             webserv;
    root                    data/www;

    client_max_body_size    1M;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 504 /errors/504.html;

    location / {
        root                data/www/vespera;
        index               index.html;
        methods             GET;
        autoindex           off;
    }

    location /cgi-bin {
        root                data/cgi-bin;
        methods             POST;
        cgi_extension       .py  /usr/bin/python3;
        index               index.py;
    }
}
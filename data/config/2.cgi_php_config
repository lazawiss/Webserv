# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

server {

    listen                  127.0.0.1:8080;
    server_name             webserv;
    root                    data/www;

    client_max_body_size    1M;

    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;

    location / {
        client_max_body_size    1M;

        root                data/www/html;
        index               index2.html index.html;
        methods             GET;
        autoindex           off;
    }

    location /cgi-bin {
        
        client_max_body_size    1M;

        root                data/cgi-bin;
        methods             POST;
        cgi_extension       .php /usr/bin/php-cgi;
        index               index.py;
    }

    location /upload {
        client_max_body_size    1M;

        root                data/upload;
        index               index.html;
        methods             GET POST DELETE;
        autoindex           off;
    }
}

server {
    listen       0.0.0.0:8080;
    server_name  localhost;
    client_max_body_size 10M;

    location / {
        root        data/www/html;
        index       index.html;
        methods     GET POST;
    }

    location /cgi-bin {
        root            data/cgi-bin;
        methods         GET POST;
        cgi_extension   .py  /usr/bin/python3;
    }
}
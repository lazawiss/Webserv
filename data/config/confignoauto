
server {

    listen       127.0.0.1:8080;     # même port, mais interface différente
    server_name  internal.localhost;
    root        data/www;
    error_page 404 /errors/404.html;
    autoindex   on;
    
    location /vespera {
        //root        data/www/vespera;
        methods     GET;
    }

    location / {
        //root        data/www/html;
        methods     GET;
    }

    location /cgi-bin/python {
        root            data/cgi-bin;
        methods         POST;
        cgi_extension   .py  /usr/bin/python3;
        index           index.py;
    }

    location /api {
        //root        data/www/html1;
        methods     GET;
    }

    location /upload {
        //root        data/upload;
        index       index.html;
        methods     GET POST DELETE;
    }
}
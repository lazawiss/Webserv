server {

    listen       127.0.0.1:8080;
    server_name  internal.localhost;
    root        data/www;
    error_page 400 /errors/404.html;

    root            data/www;

    location / {
        root        data/www/html;
        #index       index2.html index.html;
        methods     GET;
        autoindex   on;
    }

    location /api {
        root        data/www/html1;
        methods     GET;
        autoindex   off;
    }


    location /upload {
        root        data/upload;
        methods     GET POST DELETE;
        autoindex   off;
    }
}

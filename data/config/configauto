server {

    listen       127.0.0.1:8080;
    server_name  internal.localhost;
    root        data/www;
    error_page 404 /errors/404.html;


    location / {
        root        data/www/html;
        index       index2.html index.html;
        methods     GET;
        autoindex   on;
    }

    location /api {
        root        data/www/diary;
        methods     GET;
        autoindex   off;
    }


    location /upload {
        root        data/upload;
        //index       index.html;
        methods     GET POST DELETE;
        autoindex   off;
    }

    location /cgi-bin {
    root            data/cgi-bin;
    methods         GET POST;
    index           index.py;
    //cgi_extension   .py  /usr/bin/python3;
    //cgi_extension   .php /usr/bin/php-cgi;
    }
}


# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

server {
    listen          0.0.0.0:8080;
    server_name     webserv;

    error_page 404 /errors/404.html;
    error_page 405 /errors/405.html;

    location / {
        root        data/www/html;
        index       index.html;
        methods     GET;
        autoindex   off;
    }

    #location /upload {


# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

server {
    listen          0.0.0.0:8080;
    server_name     webserv;

    location / {
        root        data/www/html;
        index       index.html;
        methods     GET;
        autoindex   off;
    }

    location /upload {
        root        data/upload;
        index       index.html;
        methods     GET POST DELETE;
        autoindex   off;
    }
}

# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

server {
    listen       127.0.0.1:8081;

    error_page 404 /errors/404.html;

    location / {
        root        data/www/diary;
        index       index.html;
        methods     GET;
        autoindex   off;
    }
}

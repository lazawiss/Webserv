# ─────────────────────────────────────────
#  SERVEUR
# ─────────────────────────────────────────

autoindex   on;

server {

    listen       127.0.0.1:8080;
    server_name  internal.localhost;
    //root        data;
    error_page 404 /errors/404.html;
    error_page 500 /errors/500.html;
    error_page 405 /errors/405.html;
    
    location /vespera {
        #root        data/www/vespera;
        #index       index.html;
        methods     GET;
        #autoindex   off;
    }

    location / {
        #root        data/www/html;
        #index       index2.html index.html;
        methods     GET;
        #autoindex   on;
    }

    location /cgi-bin {
        //root            data/cgi-bin;
        // methods         GET POST;
        cgi_extension   .py  /usr/bin/python3;
        //cgi_extension   .php /usr/bin/php-cgi;
        index           index.py;
    }

    location /api {
        //root        data/www/diary;
        //index       index2.html index.html;
        methods     GET;
        //autoindex   on;
    }

    location /upload {
        //root        data/upload;
        //index       index.html;
        methods     GET POST DELETE;
        //autoindex   off;
    }

}
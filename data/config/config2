# ─────────────────────────────────────────
#  SERVEUR 3 — Même port, autre interface
# ─────────────────────────────────────────
server {
    listen       127.0.0.1:8080;     # même port, mais interface différente
    server_name  internal.localhost;

    error_page 400 /errors/404.html;

    location / {
        root        data/www/html;
        index       index2.html index.html;
        methods     GET;
        autoindex   on;
    }

    location /cgi-bin/python {
        root            data/cgi-bin;
        methods         DELETE;
        cgi_extension   .py  /usr/bin/python3;
        index           index.py;
    }

    location /api {
        root        data/www/html1;
        methods     GET;
        autoindex   on;
    }

    location /upload {
        root        data/upload;
        methods     GET POST DELETE;
        autoindex   off;
    }

    location /image.html {
        return      301 redirection/index.html; # redirection permanente

    }

    location /google {
        return      302 https://www.google.com; # redirection externe
    }

    location /redirection {
        root        data/www;
        index       index.html;
        methods     GET;
    }

}

